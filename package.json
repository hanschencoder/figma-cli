{
  "name": "figma-cli-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @figma-cli/shared && npm run build -w @figma-cli/server && npm run build -w @figma-cli/plugin",
    "build:server": "npm run build -w @figma-cli/server",
    "build:plugin": "npm run build -w @figma-cli/plugin",
    "dev:plugin": "npm run dev -w @figma-cli/plugin",
    "typecheck": "tsc -b packages/shared packages/server packages/plugin",
    "clean": "rm -rf packages/*/dist packages/*/build packages/*/*.tsbuildinfo",
    "smoke": "node scripts/smoke.mjs",
    "setup": "bash scripts/install.sh",
    "server": "node packages/server/dist/daemon-entry.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
